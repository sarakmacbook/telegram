# ── Required ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ── Widget ──────────────────────────────────────────────────────────────────
# HTML file sent as the body of sendWidget
WIDGET_PATH=index.html
# How many offers to put in the widget state. Kept low on purpose: widget state
# is limited to 1024 bytes and a widget bubble is clipped at 600 px of height.
MAX_OFFERS=3
# width/height anchors for sendWidget (logical px). Empty = automatic.
WIDGET_WIDTH=
WIDGET_HEIGHT=

# ── Offers feed ─────────────────────────────────────────────────────────────
# Optional HTTPS endpoint returning offers. When empty (or unreachable) the bot
# falls back to the clearly-labelled built-in sample feed.
FEED_URL=
# Accepted shapes: [...] or {"offers":[...]}. Field aliases are listed in
# src/feed.mjs -> normalizeOffers().
FEED_TIMEOUT_MS=8000
FEED_CACHE_MS=30000

# ── Shared ("live") widget ──────────────────────────────────────────────────
# Client-side refresh period of the shared widget's public data, 5-3600 seconds
SHARED_CACHE_TIME=15
# Pin a shared widget id so /resend survives a serverless cold start
SHARED_WIDGET_ID=

# ── Webhook / Vercel ────────────────────────────────────────────────────────
# Public URL of the deployed function, e.g. https://my-bot.vercel.app/api/webhook
WEBHOOK_URL=
# Required for the Vercel webhook and its setup endpoint; Telegram echoes it in the request header
WEBHOOK_SECRET=
# Set the webhook automatically from the CLI / setup endpoint
AUTO_SET_WEBHOOK=true
# ── Misc ────────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
LOG_FORMAT=pretty
# Point at https://api.telegram.org/beta or a local mock server when testing
TELEGRAM_API_ROOT=https://api.telegram.org
